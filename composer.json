{
  "name": "maheralyamany/laravel-core-tools",
  "description": "Core helpers and request security tools for Laravel",
  "homepage": "https://github.com/maheralyamany/laravel-core-tools",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Maher Alyamany",
      "email": "maheralyamany4@gmail.com"
    }
  ],
  "keywords": [
    "Maher Alyamany",
    "MaherAlyamany",
    "maheralyamany",
    "laravel",
    "security",
    "helpers",
    "core"
  ],
  "support": {
    "issues": "https://github.com/maheralyamany/laravel-core-tools/issues",
    "source": "https://github.com/maheralyamany/laravel-core-tools"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Maher\\CoreTools\\": "src/"
    },
    "files": [
      "src/Helpers/arrayHelper.php",
      "src/Helpers/baseHelper.php",
      "src/Helpers/datetimeHelper.php",
      "src/Helpers/languageHelper.php",
      "src/Helpers/internetHelper.php",
      "src/Helpers/routeHelper.php",
      "src/helpers/strHelper.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Maher\\CoreTools\\CoreToolsServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.0|^8.1|^8.2|^8.3|^8.4",
    "illuminate/support": ">=10.0",
    "illuminate/console": ">=10.0",
    "illuminate/config": ">=10.0",
    "illuminate/cache": ">=10.0",
    "illuminate/database": ">=10.0",
    "illuminate/contracts": ">=10.0",
    "illuminate/filesystem": ">=10.0"
  }
}